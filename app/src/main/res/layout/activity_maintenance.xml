<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="24dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Odómetro actual (km):" android:textColor="@color/text_primary" android:textSize="18sp" />
        <EditText android:id="@+id/edtOdometer" android:layout_width="150dp" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text_primary" android:textSize="18sp" />
        <Button android:id="@+id/btnSaveOdometer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Guardar" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aceite de motor" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtEngineLast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/txtEngineNext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <Button android:id="@+id/btnEngineChange" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cambio hecho" />
                    <Button android:id="@+id/btnEngineEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aceite de caja" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtGearboxLast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/txtGearboxNext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <Button android:id="@+id/btnGearboxChange" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cambio hecho" />
                    <Button android:id="@+id/btnGearboxEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
