<?xml version="1.0" encoding="utf-8"?>
<!-- La pantalla se diseña a 1280x720 y ScaleLayout la escala para que entre igual en cualquier radio. -->
<com.rgservice.carlauncher13.ScaleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scaler"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cGround">

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/home"
            layout="@layout/home" />

        <FrameLayout
            android:id="@+id/screenHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/splash"
            layout="@layout/splash"
            android:visibility="gone" />
    </FrameLayout>
</com.rgservice.carlauncher13.ScaleLayout>
