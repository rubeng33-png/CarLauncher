<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema oscuro (noche) -->
    <style name="Theme.Car.Dark" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="cGround">#FF0B0D10</item>
        <item name="cCard">#FF15181D</item>
        <item name="cCard2">#FF1D2128</item>
        <item name="cLine">#FF272C34</item>
        <item name="cText">#FFF3F5F7</item>
        <item name="cMuted">#FF9BA5B1</item>
        <item name="cAccent">#FF6FB1FF</item>
        <item name="cOnAccent">#FF0B0E12</item>
        <item name="cWarn">#FFFF7A59</item>
        <item name="cTrack">#FF272D36</item>
        <item name="cTick">#FF3A414B</item>
        <item name="cPill">#246FB1FF</item>
        <item name="cGlow">#266FB1FF</item>
        <item name="cSeg">#FF0F1215</item>
        <item name="cArt1">#FF3D7BD9</item>
        <item name="cArt2">#FF1C2F55</item>
        <item name="cArt3">#FF101826</item>
        <item name="android:windowBackground">#FF0B0D10</item>
        <item name="android:statusBarColor">#FF0B0D10</item>
        <item name="android:navigationBarColor">#FF0B0D10</item>
        <item name="android:colorAccent">#FF6FB1FF</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>

    <!-- Estilos de textos y bloques reutilizados -->
    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">22dp</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">?attr/cMuted</item>
        <item name="android:textSize">15dp</item>
    </style>
    <style name="GaugeCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="GaugeCenter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="GaugeNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">28dp</item>
    </style>
    <style name="GaugeUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:text">km restantes</item>
        <item name="android:textColor">?attr/cMuted</item>
        <item name="android:textSize">15dp</item>
    </style>
    <style name="GaugeName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textColor">?attr/cText</item>
        <item name="android:textSize">21dp</item>
    </style>
    <style name="GaugeSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">?attr/cMuted</item>
        <item name="android:textSize">16dp</item>
    </style>

    <!-- Tema claro (día) -->
    <style name="Theme.Car.Light" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="cGround">#FFE6E9ED</item>
        <item name="cCard">#FFFBFCFD</item>
        <item name="cCard2">#FFEEF1F5</item>
        <item name="cLine">#FFD8DDE4</item>
        <item name="cText">#FF10141A</item>
        <item name="cMuted">#FF556070</item>
        <item name="cAccent">#FF1B66E0</item>
        <item name="cOnAccent">#FFFFFFFF</item>
        <item name="cWarn">#FFC2361A</item>
        <item name="cTrack">#FFE1E5EB</item>
        <item name="cTick">#FFC3CAD3</item>
        <item name="cPill">#1A1B66E0</item>
        <item name="cGlow">#1F1B66E0</item>
        <item name="cSeg">#FFEEF1F5</item>
        <item name="cArt1">#FF5A98F0</item>
        <item name="cArt2">#FF1E4FA8</item>
        <item name="cArt3">#FF17305E</item>
        <item name="android:windowBackground">#FFE6E9ED</item>
        <item name="android:statusBarColor">#FFE6E9ED</item>
        <item name="android:navigationBarColor">#FFE6E9ED</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#FF1B66E0</item>
        <item name="android:fontFamily">@font/barlow_regular</item>
    </style>
</resources>
